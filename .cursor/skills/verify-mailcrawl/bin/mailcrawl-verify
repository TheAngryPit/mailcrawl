#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="${REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
RUN_ID="${RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
EVIDENCE_DIR="${EVIDENCE_DIR:-/tmp/mailcrawl-verify-evidence/$RUN_ID}"
SCRATCH_DIR="/tmp/mailcrawl-verify-scratch/$RUN_ID"

log() {
  echo "[mailcrawl-verify] $*"
}

append_summary() {
  local feature="$1" code="$2"
  printf '%s feature=%s exit=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$feature" "$code" >>"$EVIDENCE_DIR/summary.txt"
}

scaffold_proof_runnable() {
  [[ -f "$REPO_ROOT/Makefile" && -f "$REPO_ROOT/scripts/proof.sh" ]]
}

rules_runnable() {
  [[ -f "$REPO_ROOT/testdata/rules/rules-v0.json" ]]
}

stats_runnable() {
  rules_runnable
}

taxonomy_runnable() {
  [[ -f "$REPO_ROOT/testdata/catalogue/taxonomy.synthetic.json" ]]
}

wheel_scenarios_runnable() {
  [[ -f "$REPO_ROOT/pyproject.toml" && -f "$REPO_ROOT/mailcrawl/rules-v0.json" ]] || return 1
  python3 -m pip --version >/dev/null 2>&1 || return 1
  python3 -m venv --help >/dev/null 2>&1 || return 1
}

ensure_wheel() {
  local venv="$SCRATCH_DIR/venv"
  if [[ -x "$venv/bin/python" ]] && (
    cd /tmp
    "$venv/bin/python" -c "import mailcrawl; raise SystemExit(0 if 'site-packages' in mailcrawl.__file__ else 1)"
  ); then
    return 0
  fi
  mkdir -p "$SCRATCH_DIR"
  rm -rf "$venv"
  python3 -m venv "$venv"
  (
    cd /tmp
    "$venv/bin/python" -m pip install --disable-pip-version-check 'setuptools>=77'
    "$venv/bin/python" -m pip install --disable-pip-version-check \
      --no-deps --no-build-isolation "$REPO_ROOT"
  )
}

drive_wheel_scenario() {
  local name="$1"
  if ! wheel_scenarios_runnable; then
    log "$name: not runnable"
    return 2
  fi
  mkdir -p "$SCRATCH_DIR"
  ensure_wheel
  local empty
  empty="$(mktemp -d "$SCRATCH_DIR/empty.XXXXXX")"
  (
    cd "$empty"
    env \
      -u GOG_KEY \
      -u OPENAI_API_KEY \
      -u ANTHROPIC_API_KEY \
      -u GH_TOKEN \
      -u GITHUB_TOKEN \
      -u GOOGLE_APPLICATION_CREDENTIALS \
      -u TYPESAFE_API_KEY \
      -u JEV_API_KEY \
      HOME="$empty" \
      http_proxy=http://127.0.0.1:9 \
      https_proxy=http://127.0.0.1:9 \
      HTTP_PROXY=http://127.0.0.1:9 \
      HTTPS_PROXY=http://127.0.0.1:9 \
      ALL_PROXY=http://127.0.0.1:9 \
      "$SCRATCH_DIR/venv/bin/python" \
      "$REPO_ROOT/.cursor/skills/verify-mailcrawl/bin/wheel-scenarios.py" \
      "$name"
  )
}

attachment_parse_runnable() {
  body_clean_runnable && native_fixture_runnable
}

body_clean_runnable() {
  [[ -f "$REPO_ROOT/testdata/fixtures/gog-export/v0/export.json" ]]
}

native_fixture_runnable() {
  local native="$REPO_ROOT/testdata/fixtures/gog-export/native"
  local taxonomy="$REPO_ROOT/testdata/catalogue/taxonomy.synthetic.json"
  [[ -f "$native/gmail/acct_synthetic/labels.json" \
    && -f "$native/gmail/acct_synthetic/messages/index.jsonl" \
    && -f "$taxonomy" \
    && ! -e "$native/export.json" ]]
}

mbox_fixture_runnable() {
  local fixture="$REPO_ROOT/testdata/fixtures/mbox"
  [[ -f "$fixture/takeout.mbox" \
    && -f "$fixture/gog-after/gmail/acct_synthetic/labels.json" \
    && -f "$fixture/gog-after/gmail/acct_synthetic/messages/index.jsonl" ]]
}

mailcrawl_in() {
  local home="$1"
  shift
  (
    cd "$REPO_ROOT"
    env \
      -u GOG_KEY \
      -u OPENAI_API_KEY \
      -u ANTHROPIC_API_KEY \
      -u GH_TOKEN \
      -u GITHUB_TOKEN \
      -u GOOGLE_APPLICATION_CREDENTIALS \
      HOME="$home" \
      http_proxy=http://127.0.0.1:9 \
      https_proxy=http://127.0.0.1:9 \
      HTTP_PROXY=http://127.0.0.1:9 \
      HTTPS_PROXY=http://127.0.0.1:9 \
      ALL_PROXY=http://127.0.0.1:9 \
      python3 -m mailcrawl "$@"
  )
}

record_spec_hash() {
  mkdir -p "$EVIDENCE_DIR"
  sha256sum "$REPO_ROOT/docs/SPEC.md" | awk '{print $1}' >"$EVIDENCE_DIR/spec.sha256"
}

verify_spec_unchanged() {
  local before after
  before="$(cat "$EVIDENCE_DIR/spec.sha256")"
  after="$(sha256sum "$REPO_ROOT/docs/SPEC.md" | awk '{print $1}')"
  if [[ "$before" != "$after" ]]; then
    log "docs/SPEC.md changed during verification (hash mismatch)"
    return 1
  fi
  log "docs/SPEC.md unchanged"
  return 0
}

docs_secret_check() {
  "$REPO_ROOT/scripts/hygiene.sh"
}

drive_required_docs_and_ci() {
  local fail=0
  cd "$REPO_ROOT"
  for f in README.md docs/SPEC.md SECURITY.md CONTRIBUTING.md \
    .github/CODEOWNERS .github/dependabot.yml .github/workflows/check.yml; do
    if [[ ! -f "$f" ]]; then
      echo "missing $f"
      fail=1
    else
      echo "present $f"
    fi
  done
  [[ "$fail" -eq 0 ]]
}

drive_secrets_and_tracked_forbidden() {
  docs_secret_check
}

drive_spec_integrity() {
  verify_spec_unchanged
}

drive_scaffold_headless_proof() {
  if ! scaffold_proof_runnable; then
    log "scaffold-headless-proof: not runnable (need Makefile and scripts/proof.sh)"
    return 2
  fi
  cd "$REPO_ROOT"
  make check && scripts/proof.sh
}

drive_native_gog_import() {
  if ! native_fixture_runnable; then
    log "native gog import: not runnable"
    return 2
  fi
  mkdir -p "$SCRATCH_DIR"
  local home
  home="$(mktemp -d "$SCRATCH_DIR/native-home.XXXXXX")"
  NATIVE_HOME="$home"
  trap 'rm -rf "$NATIVE_HOME"' EXIT
  local native="$REPO_ROOT/testdata/fixtures/gog-export/native"
  local taxonomy="$REPO_ROOT/testdata/catalogue/taxonomy.synthetic.json"

  mailcrawl_in "$home" --json init --account thehive --email ada@example.com

  local import_out
  import_out="$(mailcrawl_in "$home" --json import gog-export \
    --account thehive \
    --dir "$native" \
    --taxonomy "$taxonomy")"
  printf '%s\n' "$import_out"
  printf '%s' "$import_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
ok = (
    doc.get("ok") is True
    and doc.get("n_seen") == 3
    and doc.get("n_new") == 3
    and doc.get("n_error") == 0
)
sys.exit(0 if ok else 1)
' || {
    log "native import count is not 3"
    return 1
  }

  local search_out
  search_out="$(mailcrawl_in "$home" --json search reuniao --account thehive)"
  printf '%s\n' "$search_out"
  printf '%s' "$search_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
hits = doc.get("hits") or []
ok = any(
    hit.get("gmail_message_id") == "msg-plain"
    and "reunião" in (hit.get("snippet") or "")
    for hit in hits
)
sys.exit(0 if ok else 1)
' || {
    log "native search reuniao missed reunião"
    return 1
  }

  local again_out
  again_out="$(mailcrawl_in "$home" --json import gog-export \
    --account thehive \
    --dir "$native")"
  printf '%s\n' "$again_out"
  printf '%s' "$again_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
ok = doc.get("n_dup") == 3 and doc.get("n_new") == 0
sys.exit(0 if ok else 1)
' || {
    log "native reimport was not a duplicate"
    return 1
  }

  local bad_out bad_err bad_code
  bad_err="$(mktemp "$SCRATCH_DIR/native-missing.XXXXXX")"
  bad_code=0
  bad_out="$(mailcrawl_in "$home" --json import gog-export \
    --account thehive \
    --dir "$home/missing-export" 2>"$bad_err")" || bad_code=$?
  printf '%s\n' "$bad_out"
  if [[ "$bad_code" -ne 3 ]]; then
    log "native-gog-import: missing directory exited $bad_code"
    return 1
  fi
  printf '%s' "$bad_out" | grep -q unsupported_schema || {
    log "native-gog-import: missing directory lacked unsupported_schema"
    return 1
  }
  if grep -q Traceback "$bad_err" || printf '%s' "$bad_out" | grep -q Traceback; then
    log "native-gog-import: missing directory printed a traceback"
    return 1
  fi
  rm -f "$bad_err"
  rm -rf "$NATIVE_HOME"
  trap - EXIT
}

drive_body_clean() {
  if ! body_clean_runnable; then
    log "body clean: not runnable"
    return 2
  fi
  mkdir -p "$SCRATCH_DIR"
  local home
  home="$(mktemp -d "$SCRATCH_DIR/body-home.XXXXXX")"
  BODY_HOME="$home"
  trap 'rm -rf "$BODY_HOME"' EXIT
  local export_dir="$REPO_ROOT/testdata/fixtures/gog-export/v0"
  local taxonomy="$REPO_ROOT/testdata/catalogue/taxonomy.synthetic.json"
  local db="$home/.local/share/mailcrawl/personal.db"

  mailcrawl_in "$home" --json init --account personal --email ada@example.com

  local import_out
  import_out="$(mailcrawl_in "$home" --json import gog-export \
    --account personal \
    --dir "$export_dir" \
    --taxonomy "$taxonomy")"
  printf '%s\n' "$import_out"
  printf '%s' "$import_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
ok = doc.get("ok") is True and doc.get("n_new") == 2 and doc.get("n_error") == 0
sys.exit(0 if ok else 1)
' || {
    log "body clean: v0 import failed"
    return 1
  }

  local quoted_out fake_out
  quoted_out="$(mailcrawl_in "$home" --json search quoted --account personal)"
  fake_out="$(mailcrawl_in "$home" --json search fake --account personal)"
  printf '%s\n' "$quoted_out"
  printf '%s\n' "$fake_out"
  DB_PATH="$db" QUOTED_JSON="$quoted_out" FAKE_JSON="$fake_out" python3 - <<'PY' || {
import json, os, sqlite3, sys
quoted = json.loads(os.environ["QUOTED_JSON"])
fake = json.loads(os.environ["FAKE_JSON"])
if quoted.get("hits"):
    sys.exit("quoted search returned hits")
ids = [hit.get("gmail_message_id") for hit in fake.get("hits") or []]
if "fixture-001" not in ids:
    sys.exit("fake search missed fixture-001")
conn = sqlite3.connect(os.environ["DB_PATH"])
try:
    raw, body = conn.execute(
        "SELECT body_text_raw, body_text FROM messages WHERE gmail_message_id = 'fixture-001'"
    ).fetchone()
    if "> quoted line stays" not in raw or "-- \nAda Fixture" not in raw:
        sys.exit("raw body dropped the quote or signature")
    if body != "This body is fake fixture text.":
        sys.exit("cleaned body is not the kept sentence")
    version = conn.execute("PRAGMA user_version").fetchone()[0]
    if version != 11:
        sys.exit(f"user_version {version}")
    names = {row[0] for row in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    for table in ("decisions", "sender_decisions", "thread_mutes"):
        if table not in names:
            sys.exit(f"missing {table}")
    for banned in ("plans", "proposals", "embeddings", "clips"):
        if banned in names:
            sys.exit(f"unexpected {banned}")
finally:
    conn.close()
PY
    log "body clean: cleaned index check failed"
    return 1
  }

  local html_dir="$home/html-export"
  mkdir -p "$html_dir"
  cat >"$html_dir/export.json" <<'JSON'
{
  "schema": "mailcrawl.gog-export.v0",
  "example_manifest": {"messages": 1},
  "example_messages": [
    {
      "example_message_id": "html-clean-001",
      "example_thread_id": "thread-html-clean",
      "example_label_ids": ["INBOX"],
      "example_date": 1760054400,
      "example_from": "Ada Fixture <ada@example.com>",
      "example_html": "<p>Keep linhawordqx</p><blockquote>citacao quotewordqx</blockquote>"
    }
  ]
}
JSON
  mailcrawl_in "$home" --json import gog-export --account personal --dir "$html_dir" >/dev/null
  local html_out
  html_out="$(mailcrawl_in "$home" --json search quotewordqx --account personal)"
  printf '%s\n' "$html_out"
  printf '%s' "$html_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
ids = [hit.get("gmail_message_id") for hit in doc.get("hits") or []]
sys.exit(0 if "html-clean-001" in ids else 1)
' || {
    log "body clean: html blockquote was cut"
    return 1
  }
  rm -rf "$BODY_HOME"
  trap - EXIT
}

drive_attachment_parse() {
  if ! attachment_parse_runnable; then
    log "attachment parse: not runnable"
    return 2
  fi
  mkdir -p "$SCRATCH_DIR"
  local home
  home="$(mktemp -d "$SCRATCH_DIR/attach-home.XXXXXX")"
  ATTACH_HOME="$home"
  trap 'rm -rf "$ATTACH_HOME"' EXIT
  local taxonomy="$REPO_ROOT/testdata/catalogue/taxonomy.synthetic.json"
  local personal="$home/.local/share/mailcrawl/personal.db"
  local hive="$home/.local/share/mailcrawl/thehive.db"

  mailcrawl_in "$home" --json init --account personal --email ada@example.com
  mailcrawl_in "$home" --json init --account thehive --email ada@example.com
  mailcrawl_in "$home" --json import gog-export \
    --account personal \
    --dir "$REPO_ROOT/testdata/fixtures/gog-export/v0" \
    --taxonomy "$taxonomy" >/dev/null
  mailcrawl_in "$home" --json import gog-export \
    --account thehive \
    --dir "$REPO_ROOT/testdata/fixtures/gog-export/native" \
    --taxonomy "$taxonomy" >/dev/null

  PERSONAL_DB="$personal" HIVE_DB="$hive" python3 - <<'PY' || {
import os, sqlite3, sys
from mailcrawl.extract import BackendRead, parse_attachment

personal = sqlite3.connect(os.environ["PERSONAL_DB"])
try:
    row = personal.execute(
        "SELECT extract_status, extract_method, file_sha256 FROM attachments"
    ).fetchone()
finally:
    personal.close()
if row != ("skipped", "no_bytes", None):
    sys.exit(f"v0 attachment {row}")

hive = sqlite3.connect(os.environ["HIVE_DB"])
try:
    rows = {
        name: (status, text, digest)
        for name, status, text, digest in hive.execute(
            "SELECT filename, extract_status, extracted_text, file_sha256 FROM attachments"
        )
    }
    marker = hive.execute(
        "SELECT count(*) FROM msg_fts WHERE msg_fts MATCH 'ZZBINMARKERZZ'"
    ).fetchone()[0]
finally:
    hive.close()
if rows["note.txt"][0] != "ok" or "attachmenttoken" not in (rows["note.txt"][1] or ""):
    sys.exit(f"text attachment {rows.get('note.txt')}")
if rows["blob.bin"][0] != "unsupported" or rows["blob.bin"][1] is not None:
    sys.exit(f"binary attachment {rows.get('blob.bin')}")
if marker != 0 or not rows["note.txt"][2] or not rows["blob.bin"][2]:
    sys.exit("hash or index check failed")

class Present:
    def available(self, kind: str) -> bool:
        return True
    def read(self, kind: str, payload: bytes) -> BackendRead:
        return BackendRead("x" * 24, 1, 59.0)

low = parse_attachment("application/pdf", b"%PDF", backend=Present())
missing = parse_attachment("application/pdf", b"%PDF")
if low.ocr_status != "low_confidence" or low.extract_status != "ok":
    sys.exit(f"threshold {low}")
if missing.extract_status != "skipped" or missing.ocr_status != "not_needed":
    sys.exit(f"default backend {missing}")
print("attachment parse ok")
PY
    log "attachment parse: status check failed"
    return 1
  }
  rm -rf "$ATTACH_HOME"
  trap - EXIT
}

drive_rules_v0() {
  if ! rules_runnable; then
    log "rules v0: not runnable"
    return 2
  fi
  mkdir -p "$SCRATCH_DIR"
  local home
  home="$(mktemp -d "$SCRATCH_DIR/rules-home.XXXXXX")"
  RULES_HOME="$home"
  trap 'rm -rf "$RULES_HOME"' EXIT
  mailcrawl_in "$home" --json init --account vcl --email ada@example.com >/dev/null
  local db="$home/.local/share/mailcrawl/vcl.db"
  DB_PATH="$db" python3 - <<'PY'
import os, sqlite3
conn = sqlite3.connect(os.environ["DB_PATH"])
conn.execute("PRAGMA foreign_keys = ON")
account = conn.execute("SELECT account_id FROM accounts").fetchone()[0]
now = 1700000000

def add(number, body, starred):
    conn.execute(
        "INSERT INTO senders(account_id, address_norm, domain) VALUES (?, ?, 'example.com')",
        (account, f"bao{number}@example.com"),
    )
    sender = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
    conn.execute(
        "INSERT INTO threads(account_id, gmail_thread_id) VALUES (?, ?)",
        (account, f"rules-{number}"),
    )
    thread = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
    conn.execute(
        """
        INSERT INTO messages(
          account_id, gmail_message_id, thread_pk, internal_date, sender_id,
          body_text, is_from_me, raw_sha256, provenance_hash, imported_at
        ) VALUES (?, ?, ?, ?, ?, ?, 0, 'raw', 'prov', ?)
        """,
        (account, f"rules-msg-{number}", thread, now - 86400, sender, body, now),
    )
    if starred:
        msg = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
        conn.execute(
            "INSERT INTO labels(account_id, gmail_label_id, name, kind, seen_at) VALUES (?, 'STARRED', 'STARRED', 'system', ?)",
            (account, now),
        )
        conn.execute(
            "INSERT INTO message_labels(msg_pk, account_id, gmail_label_id, observed_at) VALUES (?, ?, 'STARRED', ?)",
            (msg, account, now),
        )

add(1, "secretbodyqx", True)
add(2, "hello there", False)
conn.commit()
conn.close()
PY
  local rules_out
  rules_out="$(mailcrawl_in "$home" --json rules \
    --account vcl \
    --rules "$REPO_ROOT/testdata/rules/rules-v0.json" \
    --now 1700000000)"
  printf '%s\n' "$rules_out"
  if printf '%s' "$rules_out" | grep -q secretbodyqx; then
    log "rules v0: output included message text"
    return 1
  fi
  printf '%s' "$rules_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
ok = (
    doc.get("rules_version") == "rules-v4"
    and doc.get("threads") == 2
    and doc.get("covered") == 2
    and doc.get("by_state") == {"needs_review": 1, "reply": 1}
    and doc.get("by_rule") == {"0": 1, "5": 1}
)
sys.exit(0 if ok else 1)
' || {
    log "rules v0: counts drifted"
    return 1
  }
  mailcrawl_in "$home" --json rules \
    --account vcl \
    --rules "$REPO_ROOT/testdata/rules/rules-v0.json" \
    --now 1700000000 >/dev/null
  local count
  count="$(python3 - "$db" <<'PY'
import sqlite3, sys
print(sqlite3.connect(sys.argv[1]).execute("SELECT count(*) FROM decisions").fetchone()[0])
PY
)"
  if [[ "$count" != "2" ]]; then
    log "rules v0: rerun added decisions"
    return 1
  fi
  rm -rf "$RULES_HOME"
  trap - EXIT
}

drive_stats_dry_run() {
  if ! stats_runnable; then
    log "stats dry-run: not runnable"
    return 2
  fi
  mkdir -p "$SCRATCH_DIR"
  local home
  home="$(mktemp -d "$SCRATCH_DIR/stats-home.XXXXXX")"
  STATS_HOME="$home"
  trap 'rm -rf "$STATS_HOME"' EXIT
  mailcrawl_in "$home" --json init --account vcl --email ada@example.com >/dev/null
  local db="$home/.local/share/mailcrawl/vcl.db"
  DB_PATH="$db" python3 - <<'PY'
import os, sqlite3
conn = sqlite3.connect(os.environ["DB_PATH"])
conn.execute("PRAGMA foreign_keys = ON")
account = conn.execute("SELECT account_id FROM accounts").fetchone()[0]
now = 1700000000

def add(number, body, starred):
    conn.execute(
        "INSERT INTO senders(account_id, address_norm, domain) VALUES (?, ?, 'example.com')",
        (account, f"bao{number}@example.com"),
    )
    sender = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
    conn.execute(
        "INSERT INTO threads(account_id, gmail_thread_id) VALUES (?, ?)",
        (account, f"rules-{number}"),
    )
    thread = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
    conn.execute(
        """
        INSERT INTO messages(
          account_id, gmail_message_id, thread_pk, internal_date, sender_id,
          body_text, is_from_me, raw_sha256, provenance_hash, imported_at
        ) VALUES (?, ?, ?, ?, ?, ?, 0, 'raw', 'prov', ?)
        """,
        (account, f"rules-msg-{number}", thread, now - 86400, sender, body, now),
    )
    if starred:
        msg = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
        conn.execute(
            "INSERT INTO labels(account_id, gmail_label_id, name, kind, seen_at) VALUES (?, 'STARRED', 'STARRED', 'system', ?)",
            (account, now),
        )
        conn.execute(
            "INSERT INTO message_labels(msg_pk, account_id, gmail_label_id, observed_at) VALUES (?, ?, 'STARRED', ?)",
            (msg, account, now),
        )

add(1, "secretbodyqx", True)
add(2, "hello there", False)
conn.commit()
conn.close()
PY
  local old_home old_db fill_out
  old_home="$(mktemp -d "$SCRATCH_DIR/old-tax.XXXXXX")"
  mailcrawl_in "$old_home" --json init --account vcl --email ada@example.com >/dev/null
  old_db="$old_home/.local/share/mailcrawl/vcl.db"
  OLD_DB="$old_db" FIXTURE="$REPO_ROOT/testdata/fixtures/old-taxonomy/pre-category.sql" python3 - <<'PY'
import os
import sqlite3
from pathlib import Path
conn = sqlite3.connect(os.environ["OLD_DB"])
conn.executescript(Path(os.environ["FIXTURE"]).read_text(encoding="utf-8"))
conn.commit()
conn.close()
PY
  fill_out="$(mailcrawl_in "$old_home" --json backfill --account vcl)"
  printf '%s\n' "$fill_out"
  printf '%s' "$fill_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
ok = doc.get("ok") is True and doc.get("updated") == 2
sys.exit(0 if ok else 1)
' || { log "stats dry-run: backfill did not fill two labels"; return 1; }
  fill_out="$(mailcrawl_in "$old_home" --json backfill --account vcl)"
  printf '%s' "$fill_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
sys.exit(0 if doc.get("updated") == 0 else 1)
' || { log "stats dry-run: second backfill was not a no-op"; return 1; }
  rm -rf "$old_home"

  local stats_out dry_out
  stats_out="$(mailcrawl_in "$home" --json stats --account vcl)"
  dry_out="$(mailcrawl_in "$home" --json dry-run --account vcl --rules "$REPO_ROOT/testdata/rules/rules-v0.json" --now 1700000000)"
  printf '%s\n%s\n' "$stats_out" "$dry_out"
  STATS_JSON="$stats_out" DRY_JSON="$dry_out" python3 - <<'PY' || {
import json, os, sys
stats = json.loads(os.environ["STATS_JSON"])
dry = json.loads(os.environ["DRY_JSON"])
ok = (
    stats.get("by_category", {}).get("STARRED") == 1
    and stats.get("uncategorized") == 2
    and dry.get("by_state") == {"needs_review_rule0": 1, "reply": 1}
    and dry.get("by_rule") == {"0": 1, "5": 1}
    and dry.get("undecided") == 0
    and dry.get("decisions_by_category") == {"STARRED": {"0": 1}}
    and dry.get("inactive_reason") == "gmail_default"
)
sys.exit(0 if ok else 1)
PY
    log "stats dry-run: would-be counts drifted before any decision"
    return 1
  }
  local before
  before="$(python3 - "$db" <<'PY'
import sqlite3, sys
print(sqlite3.connect(sys.argv[1]).execute("SELECT count(*) FROM decisions").fetchone()[0])
PY
)"
  if [[ "$before" != "0" ]]; then
    log "stats dry-run: dry-run wrote decisions"
    return 1
  fi
  mailcrawl_in "$home" --json rules \
    --account vcl \
    --rules "$REPO_ROOT/testdata/rules/rules-v0.json" \
    --now 1700000000 >/dev/null
  dry_out="$(mailcrawl_in "$home" --json dry-run --account vcl --rules "$REPO_ROOT/testdata/rules/rules-v0.json" --now 1700000000)"
  printf '%s\n%s\n' "$stats_out" "$dry_out"
  if printf '%s%s' "$stats_out" "$dry_out" | grep -q secretbodyqx; then
    log "stats dry-run: output included message text"
    return 1
  fi
  if printf '%s%s' "$stats_out" "$dry_out" | grep -q '@'; then
    log "stats dry-run: output included an address"
    return 1
  fi
  STATS_JSON="$stats_out" DRY_JSON="$dry_out" python3 - <<'PY' || {
import json, os, sys
stats = json.loads(os.environ["STATS_JSON"])
dry = json.loads(os.environ["DRY_JSON"])
ok = (
    stats.get("messages") == 2
    and stats.get("threads") == 2
    and stats.get("senders") == 2
    and stats.get("by_month") == {"2023-11": 2}
    and dry.get("by_state") == {"needs_review_rule0": 1, "reply": 1}
    and dry.get("by_rule") == {"0": 1, "5": 1}
    and dry.get("by_label") == {"STARRED": 1}
    and dry.get("by_sender") == {"1": 1, "2": 1}
    and dry.get("by_month") == {"2023-11": 2}
)
sys.exit(0 if ok else 1)
PY
    log "stats dry-run: counts drifted"
    return 1
  }
  local count
  count="$(python3 - "$db" <<'PY'
import sqlite3, sys
conn = sqlite3.connect(sys.argv[1])
print(conn.execute("SELECT count(*) FROM decisions").fetchone()[0])
plans = conn.execute(
    "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'plans'"
).fetchone()
if plans is not None:
    raise SystemExit("plans")
PY
)"
  if [[ "$count" != "2" ]]; then
    log "stats dry-run: decision count changed"
    return 1
  fi
  rm -rf "$STATS_HOME"
  trap - EXIT
}

drive_mbox_import() {
  if ! mbox_fixture_runnable; then
    log "mbox import: not runnable"
    return 2
  fi
  mkdir -p "$SCRATCH_DIR"
  local home
  home="$(mktemp -d "$SCRATCH_DIR/mbox-home.XXXXXX")"
  MBOX_HOME="$home"
  trap 'rm -rf "$MBOX_HOME"' EXIT
  local fixture="$REPO_ROOT/testdata/fixtures/mbox"
  local db="$home/.local/share/mailcrawl/personal.db"

  mailcrawl_in "$home" --json init --account pessoal --email ada@example.com

  local first_out
  first_out="$(mailcrawl_in "$home" --json import mbox "$fixture/takeout.mbox" --alias pessoal)"
  printf '%s\n' "$first_out"
  local hash_before
  hash_before="$(DB_PATH="$db" python3 -c '
import os
from mailcrawl.store import connect, ordered_row_dump_hash
conn = connect(os.environ["DB_PATH"])
print(ordered_row_dump_hash(conn))
conn.close()
')"
  local again_out
  again_out="$(mailcrawl_in "$home" --json import mbox "$fixture/takeout.mbox" --account personal)"
  printf '%s\n' "$again_out"
  local hash_after
  hash_after="$(DB_PATH="$db" python3 -c '
import os
from mailcrawl.store import connect, ordered_row_dump_hash
conn = connect(os.environ["DB_PATH"])
print(ordered_row_dump_hash(conn))
conn.close()
')"
  if [[ "$hash_before" != "$hash_after" ]]; then
    log "mbox import: reimport changed the ordered-row-dump hash"
    return 1
  fi

  local stripped="$home/no-pseudo.mbox"
  SRC="$fixture/takeout.mbox" DEST="$stripped" python3 - <<'PY'
import os
from pathlib import Path
text = Path(os.environ["SRC"]).read_text(encoding="utf-8")
text = text.replace("X-Gmail-Labels: Aberto\n", "")
for name in (",Opened", "Arquivada,", ",Archived"):
    text = text.replace(name, "")
Path(os.environ["DEST"]).write_text(text, encoding="utf-8")
PY
  mailcrawl_in "$home" --json init --account vcl --email ada@example.com >/dev/null
  mailcrawl_in "$home" --json import mbox "$stripped" --alias vcl >/dev/null
  local rules_out base_rules_out dry_out base_dry_out
  rules_out="$(mailcrawl_in "$home" --json rules --account personal --rules "$REPO_ROOT/testdata/rules/rules-v0.json" --now 1767700000)"
  base_rules_out="$(mailcrawl_in "$home" --json rules --account vcl --rules "$REPO_ROOT/testdata/rules/rules-v0.json" --now 1767700000)"
  dry_out="$(mailcrawl_in "$home" --json dry-run --account personal --rules "$REPO_ROOT/testdata/rules/rules-v0.json")"
  base_dry_out="$(mailcrawl_in "$home" --json dry-run --account vcl --rules "$REPO_ROOT/testdata/rules/rules-v0.json")"
  printf '%s\n%s\n%s\n%s\n' "$rules_out" "$base_rules_out" "$dry_out" "$base_dry_out"
  if [[ "$rules_out" != "$base_rules_out" || "$dry_out" != "$base_dry_out" ]]; then
    log "mbox import: pseudo-labels changed rules or dry-run output"
    return 1
  fi
  if printf '%s' "$rules_out$dry_out" | grep -q 'pseudo:'; then
    log "mbox import: rules or dry-run printed a pseudo-label"
    return 1
  fi

  local token_out attach_out crlf_out
  token_out="$(mailcrawl_in "$home" --json search mboxtoken --account personal)"
  attach_out="$(mailcrawl_in "$home" --json search anexotoken --account personal)"
  crlf_out="$(mailcrawl_in "$home" --json search crlftoken --account personal)"
  printf '%s\n%s\n%s\n' "$token_out" "$attach_out" "$crlf_out"

  local gog_out gog_again_out
  gog_out="$(mailcrawl_in "$home" --json import gog-export --alias personal --dir "$fixture/gog-after")"
  gog_again_out="$(mailcrawl_in "$home" --json import gog-export --alias personal --dir "$fixture/gog-after")"
  printf '%s\n%s\n' "$gog_out" "$gog_again_out"

  FIRST="$first_out" AGAIN="$again_out" TOKEN="$token_out" ATTACH="$attach_out" GOG="$gog_out" GOG_AGAIN="$gog_again_out" CRLF="$crlf_out" DB_PATH="$db" \
    EML="$fixture/gog-after/gmail/acct_synthetic/messages/2026/01/m1.eml" python3 - <<'PY' || {
import hashlib, json, os, sqlite3, sys
first = json.loads(os.environ["FIRST"])
again = json.loads(os.environ["AGAIN"])
gog = json.loads(os.environ["GOG"])
ids = lambda name: [hit.get("gmail_message_id") for hit in json.loads(os.environ[name]).get("hits") or []]
if first.get("account") != "personal":
    sys.exit(f"alias pessoal resolved to {first.get('account')}")
if (first["n_seen"], first["n_new"], first["n_refused"], first["n_error"]) != (6, 5, 1, 0):
    sys.exit(f"first import {first}")
if (again["n_new"], again["n_dup"]) != (0, 5):
    sys.exit(f"reimport {again}")
if ids("TOKEN") != ["18867251edfa0001"]:
    sys.exit(f"mboxtoken hits {ids('TOKEN')}")
if ids("ATTACH") != ["18873038f7ce4003"]:
    sys.exit(f"anexotoken hits {ids('ATTACH')}")
if ids("CRLF") != ["18867251edfa0001"]:
    sys.exit(f"crlftoken hits {ids('CRLF')}")
if (gog["n_new"], gog["n_dup"], gog["n_reconciled"], gog["n_error"]) != (0, 1, 1, 0):
    sys.exit(f"gog after mbox {gog}")
gog_again = json.loads(os.environ["GOG_AGAIN"])
if (gog_again["n_new"], gog_again["n_dup"], gog_again["n_reconciled"], gog_again["n_error"]) != (0, 1, 1, 0):
    sys.exit(f"gog reimport after mbox {gog_again}")
conn = sqlite3.connect(os.environ["DB_PATH"])
try:
    if conn.execute("SELECT count(*) FROM messages").fetchone()[0] != 5:
        sys.exit("message rows changed")
    sha, body = conn.execute(
        "SELECT raw_sha256, body_text_raw FROM messages WHERE gmail_message_id = '18867251edfa0001'"
    ).fetchone()
    with open(os.environ["EML"], "rb") as handle:
        if sha != hashlib.sha256(handle.read()).hexdigest():
            sys.exit("mixed-ending Takeout message does not hash like its CRLF gog .eml")
    if "\r" in body:
        sys.exit("body_text_raw kept a CR")
    if conn.execute("SELECT count(*) FROM labels WHERE gmail_label_id LIKE 'mbox:%'").fetchone()[0]:
        sys.exit("provisional labels left")
    thread = conn.execute(
        """
        SELECT threads.gmail_thread_id FROM messages
        JOIN threads ON threads.thread_pk = messages.thread_pk
        WHERE gmail_message_id = '1886e1a4667f4002'
        """
    ).fetchone()[0]
    if thread != "1886e1a4667f4002":
        sys.exit(f"provisional thread not replaced: {thread}")
    pseudo = conn.execute(
        """
        SELECT messages.gmail_message_id, message_labels.gmail_label_id FROM message_labels
        JOIN messages ON messages.msg_pk = message_labels.msg_pk
        WHERE message_labels.gmail_label_id LIKE 'pseudo:%'
        ORDER BY 1, 2
        """
    ).fetchall()
    want = [
        ("18867251edfa0001", "pseudo:opened"),
        ("1886e1a4667f4002", "pseudo:archived"),
        ("18873038f7ce4003", "pseudo:archived"),
    ]
    if pseudo != want:
        sys.exit(f"pseudo-labels after the gog import {pseudo}")
    if conn.execute("SELECT name FROM labels WHERE gmail_label_id = 'Label_opened'").fetchone() != ("Opened",):
        sys.exit("gog user label Opened missing")
finally:
    conn.close()
print("mbox import ok")
PY
    log "mbox import: counts or reconciliation drifted"
    return 1
  }

  local text_file bad_err bad_out bad_code
  text_file="$home/not-an-mbox.txt"
  printf 'hello\n' >"$text_file"
  bad_err="$(mktemp "$SCRATCH_DIR/mbox-bad.XXXXXX")"
  bad_code=0
  bad_out="$(mailcrawl_in "$home" --json import mbox "$text_file" --alias personal 2>"$bad_err")" || bad_code=$?
  printf '%s\n' "$bad_out"
  if [[ "$bad_code" -ne 3 ]] || ! printf '%s' "$bad_out" | grep -q unsupported_schema; then
    log "mbox import: a text file exited $bad_code without unsupported_schema"
    return 1
  fi
  if grep -q Traceback "$bad_err"; then
    log "mbox import: a text file printed a traceback"
    return 1
  fi
  rm -f "$bad_err"
  rm -rf "$MBOX_HOME"
  trap - EXIT
}

drive_default_taxonomy() {
  if ! taxonomy_runnable; then
    log "default taxonomy: not runnable"
    return 2
  fi
  mkdir -p "$SCRATCH_DIR"
  local home
  home="$(mktemp -d "$SCRATCH_DIR/taxonomy-home.XXXXXX")"
  TAXONOMY_HOME="$home"
  trap 'rm -rf "$TAXONOMY_HOME"' EXIT
  local export_dir="$home/export"
  mkdir -p "$export_dir"
  cat >"$export_dir/export.json" <<'JSON'
{
  "schema": "mailcrawl.gog-export.v0",
  "synthetic": true,
  "example_manifest": {"messages": 5},
  "example_labels": [
    {"example_label_id": "CATEGORY_PROMOTIONS", "example_name": "CATEGORY_PROMOTIONS", "example_kind": "system"},
    {"example_label_id": "CATEGORY_UPDATES", "example_name": "CATEGORY_UPDATES", "example_kind": "system"},
    {"example_label_id": "CATEGORY_PERSONAL", "example_name": "CATEGORY_PERSONAL", "example_kind": "system"},
    {"example_label_id": "Lshare", "example_name": "Example/Shared", "example_kind": "user"},
    {"example_label_id": "Lhive", "example_name": "Example/HiveOnly", "example_kind": "user"},
    {"example_label_id": "Lperson", "example_name": "Example/PersonalOnly", "example_kind": "user"},
    {"example_label_id": "Lsyn", "example_name": "Example/Synthetic", "example_kind": "user"}
  ],
  "example_messages": [
    {
      "example_message_id": "tax-1",
      "example_thread_id": "tax-thread-1",
      "example_label_ids": ["CATEGORY_PROMOTIONS"],
      "example_date": 1700000000,
      "example_from": "Ada Fixture <ada1@example.com>",
      "example_body": "synthetic taxonomy body",
      "example_headers": {"list-unsubscribe": "<https://example.com/unsub>"}
    },
    {
      "example_message_id": "tax-2",
      "example_thread_id": "tax-thread-2",
      "example_label_ids": ["CATEGORY_UPDATES"],
      "example_date": 1700000000,
      "example_from": "Ada Fixture <ada2@example.com>",
      "example_body": "synthetic taxonomy body",
      "example_headers": {"list-id": "<news.example.com>"}
    },
    {
      "example_message_id": "tax-3",
      "example_thread_id": "tax-thread-3",
      "example_label_ids": ["CATEGORY_PERSONAL"],
      "example_date": 1700000000,
      "example_from": "Ada Fixture <ada3@example.com>",
      "example_body": "synthetic taxonomy body",
      "example_headers": {"precedence": "bulk"}
    },
    {
      "example_message_id": "tax-4",
      "example_thread_id": "tax-thread-4",
      "example_label_ids": ["pseudo:archived"],
      "example_date": 1700000000,
      "example_from": "Ada Fixture <ada4@example.com>",
      "example_body": "synthetic taxonomy body",
      "example_headers": {"list-unsubscribe": "<https://example.com/pseudo>"}
    },
    {
      "example_message_id": "tax-5",
      "example_thread_id": "tax-thread-5",
      "example_label_ids": ["INBOX"],
      "example_date": 1700000000,
      "example_from": "Ada Fixture <ada5@example.com>",
      "example_body": "synthetic taxonomy body",
      "example_headers": {"precedence": "list"}
    }
  ]
}
JSON

  mailcrawl_in "$home" --json init --account personal --email ada@example.com >/dev/null
  local stats_out dry_out
  mailcrawl_in "$home" --json import gog-export --account personal --dir "$export_dir" >/dev/null
  stats_out="$(mailcrawl_in "$home" --json stats --account personal)"
  dry_out="$(mailcrawl_in "$home" --json dry-run --account personal --rules "$REPO_ROOT/testdata/rules/rules-v0.json")"
  printf '%s\n%s\n' "$stats_out" "$dry_out"
  if printf '%s%s' "$stats_out" "$dry_out" | grep -q 'synthetic taxonomy body'; then
    log "default taxonomy: output included message text"
    return 1
  fi
  STATS_JSON="$stats_out" DRY_JSON="$dry_out" DB_PATH="$home/.local/share/mailcrawl/personal.db" python3 - <<'PY' || {
import json, os, sqlite3, sys
stats = json.loads(os.environ["STATS_JSON"])
dry = json.loads(os.environ["DRY_JSON"])
counts = stats.get("by_category") or {}
if counts.get("CATEGORY_PROMOTIONS") != 1 or counts.get("CATEGORY_UPDATES") != 1:
    sys.exit(f"labels {counts}")
if counts.get("CATEGORY_PERSONAL") != 1 or counts.get("INBOX") != 1:
    sys.exit(f"labels {counts}")
if "newsletter" in counts or "automated" in counts or "invoice_receipt" in counts:
    sys.exit(f"invented {counts}")
if dry.get("by_category") != counts:
    sys.exit("dry-run categories drifted")
if dry.get("inactive_reason") != "gmail_default":
    sys.exit(dry.get("inactive_reason"))
if dry.get("inactive_rules") != ["2", "2-read", "3", "4"]:
    sys.exit(dry.get("inactive_rules"))
conn = sqlite3.connect(os.environ["DB_PATH"])
try:
    rows = dict(conn.execute("SELECT gmail_label_id, catalogue_key FROM labels"))
finally:
    conn.close()
if rows.get("CATEGORY_PROMOTIONS") != "CATEGORY_PROMOTIONS":
    sys.exit(rows)
if "pseudo:archived" in rows:
    sys.exit("pseudo label stored")
print("default taxonomy gmail categories ok")
PY
    log "default taxonomy: generic signals drifted"
    return 1
  }

  local override="$home/override.json"
  cat >"$override" <<'JSON'
{
  "default": {"newsletter": ["Example/Shared"]},
  "thehive": {"invoice_receipt": ["Example/HiveOnly"]},
  "pessoal": {"contract": ["Example/PersonalOnly"]}
}
JSON
  mailcrawl_in "$home" --json init --account thehive --email ada@example.com >/dev/null
  mailcrawl_in "$home" --json init --account pessoal --email ada@example.com >/dev/null
  local hive_out person_out
  hive_out="$(mailcrawl_in "$home" --json import gog-export --account thehive --dir "$export_dir" --taxonomy "$override")"
  person_out="$(mailcrawl_in "$home" --json import gog-export --account pessoal --dir "$export_dir" --taxonomy "$override")"
  printf '%s\n%s\n' "$hive_out" "$person_out"
  HIVE_DB="$home/.local/share/mailcrawl/thehive.db" PERSON_DB="$home/.local/share/mailcrawl/personal.db" python3 - <<'PY' || {
import os, sqlite3, sys
def keys(path):
    conn = sqlite3.connect(path)
    try:
        return dict(conn.execute("SELECT gmail_label_id, catalogue_key FROM labels"))
    finally:
        conn.close()
hive = keys(os.environ["HIVE_DB"])
person = keys(os.environ["PERSON_DB"])
if hive.get("Lshare") != "newsletter" or hive.get("Lhive") != "invoice_receipt" or hive.get("Lperson") is not None:
    sys.exit(f"thehive {hive}")
if person.get("Lshare") != "newsletter" or person.get("Lperson") != "contract" or person.get("Lhive") is not None:
    sys.exit(f"personal {person}")
print("default taxonomy override ok")
PY
    log "default taxonomy: override drifted"
    return 1
  }

  local bad code
  bad="$home/bad.json"
  printf '{' >"$bad"
  code=0
  mailcrawl_in "$home" --json import gog-export --account personal --dir "$export_dir" --taxonomy "$bad" >/dev/null || code=$?
  [[ "$code" -eq 2 ]] || { log "default taxonomy: invalid JSON exited $code"; return 1; }
  printf '[]' >"$bad"
  code=0
  mailcrawl_in "$home" --json import gog-export --account personal --dir "$export_dir" --taxonomy "$bad" >/dev/null || code=$?
  [[ "$code" -eq 2 ]] || { log "default taxonomy: non-object exited $code"; return 1; }
  printf '{"work": {}}' >"$bad"
  code=0
  mailcrawl_in "$home" --json import gog-export --account personal --dir "$export_dir" --taxonomy "$bad" >/dev/null || code=$?
  [[ "$code" -eq 2 ]] || { log "default taxonomy: unknown account exited $code"; return 1; }
  printf '{"default": {"not_a_category": ["Example/Shared"]}}' >"$bad"
  code=0
  mailcrawl_in "$home" --json import gog-export --account personal --dir "$export_dir" --taxonomy "$bad" >/dev/null || code=$?
  [[ "$code" -eq 0 ]] || { log "default taxonomy: own schema exited $code"; return 1; }
  printf '{"default": {"newsletter": "Example/Shared"}}' >"$bad"
  code=0
  mailcrawl_in "$home" --json import gog-export --account personal --dir "$export_dir" --taxonomy "$bad" >/dev/null || code=$?
  [[ "$code" -eq 2 ]] || { log "default taxonomy: non-list exited $code"; return 1; }
  printf '{"default": {"newsletter": [1]}}' >"$bad"
  code=0
  mailcrawl_in "$home" --json import gog-export --account personal --dir "$export_dir" --taxonomy "$bad" >/dev/null || code=$?
  [[ "$code" -eq 2 ]] || { log "default taxonomy: non-string exited $code"; return 1; }

  printf '{"default": {"invoice_receipt": ["Example type/Missing"]}}' >"$bad"
  local warn_out
  warn_out="$(mailcrawl_in "$home" --json import gog-export --account personal --dir "$export_dir" --taxonomy "$bad")"
  printf '%s\n' "$warn_out"
  printf '%s' "$warn_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
ok = doc.get("ok") is True and doc.get("taxonomy_warnings") == 1 and doc.get("missing_labels") == ["Example type/Missing"]
sys.exit(0 if ok else 1)
' || { log "default taxonomy: missing label was not a warning"; return 1; }

  local home_file="$home/.config/mailcrawl/taxonomy.json"
  local config_file="$home/from-config.json"
  local env_file="$home/from-env.json"
  local flag_file="$home/from-flag.json"
  local config="$home/config.toml"
  mkdir -p "$home/.config/mailcrawl"
  printf '%s\n' '{"default": {"correspondence": ["Example/Synthetic"]}}' >"$home_file"
  printf '%s\n' '{"default": {"contract": ["Example/Synthetic"]}}' >"$config_file"
  printf '%s\n' '{"default": {"account_security": ["Example/Synthetic"]}}' >"$env_file"
  printf '%s\n' '{"default": {"job_alert": ["Example/Synthetic"]}}' >"$flag_file"
  mailcrawl_in "$home" --json --config "$config" init --account vcl --email ada@example.com >/dev/null
  cat >"$config" <<EOF
taxonomy = "$config_file"

[accounts.vcl]
email = "ada@example.com"
EOF
  local lookup_db="$home/.local/share/mailcrawl/vcl.db"
  mailcrawl_in "$home" --json --config "$config" import gog-export --account vcl --dir "$export_dir" >/dev/null
  LOOKUP_DB="$lookup_db" WANT=contract python3 - <<'PY' || { log "default taxonomy: config lost to home"; return 1; }
import os, sqlite3, sys
conn = sqlite3.connect(os.environ["LOOKUP_DB"])
try:
    key = conn.execute("SELECT catalogue_key FROM labels WHERE gmail_label_id = 'Lsyn'").fetchone()[0]
finally:
    conn.close()
if key != os.environ["WANT"]:
    sys.exit(key)
PY
  local env_out
  env_out="$(
    cd "$REPO_ROOT"
    env \
      -u GOG_KEY \
      HOME="$home" \
      MAILCRAWL_TAXONOMY="$env_file" \
      http_proxy=http://127.0.0.1:9 \
      https_proxy=http://127.0.0.1:9 \
      HTTP_PROXY=http://127.0.0.1:9 \
      HTTPS_PROXY=http://127.0.0.1:9 \
      ALL_PROXY=http://127.0.0.1:9 \
      python3 -m mailcrawl --json --config "$config" import gog-export --account vcl --dir "$export_dir"
  )"
  printf '%s\n' "$env_out"
  LOOKUP_DB="$lookup_db" WANT=account_security python3 - <<'PY' || { log "default taxonomy: env lost to config"; return 1; }
import os, sqlite3, sys
conn = sqlite3.connect(os.environ["LOOKUP_DB"])
try:
    key = conn.execute("SELECT catalogue_key FROM labels WHERE gmail_label_id = 'Lsyn'").fetchone()[0]
finally:
    conn.close()
if key != os.environ["WANT"]:
    sys.exit(key)
PY
  mailcrawl_in "$home" --json --config "$config" import gog-export --account vcl --dir "$export_dir" --taxonomy "$flag_file" >/dev/null
  LOOKUP_DB="$lookup_db" WANT=job_alert python3 - <<'PY' || { log "default taxonomy: flag lost to env"; return 1; }
import os, sqlite3, sys
conn = sqlite3.connect(os.environ["LOOKUP_DB"])
try:
    key = conn.execute("SELECT catalogue_key FROM labels WHERE gmail_label_id = 'Lsyn'").fetchone()[0]
finally:
    conn.close()
if key != os.environ["WANT"]:
    sys.exit(key)
PY
  printf '%s\n' '[accounts.vcl]' 'email = "ada@example.com"' >"$config"
  mailcrawl_in "$home" --json --config "$config" import gog-export --account vcl --dir "$export_dir" >/dev/null
  LOOKUP_DB="$lookup_db" WANT=correspondence python3 - <<'PY' || { log "default taxonomy: home file was not used"; return 1; }
import os, sqlite3, sys
conn = sqlite3.connect(os.environ["LOOKUP_DB"])
try:
    key = conn.execute("SELECT catalogue_key FROM labels WHERE gmail_label_id = 'Lsyn'").fetchone()[0]
finally:
    conn.close()
if key != os.environ["WANT"]:
    sys.exit(key)
PY
  local map="$home/gmail-map.json"
  printf '%s\n' '{"default": {"CATEGORY_PROMOTIONS": ["Example/Shared"]}}' >"$map"
  mailcrawl_in "$home" --json import gog-export --account personal --dir "$export_dir" --taxonomy "$map" >/dev/null
  MAP_DB="$home/.local/share/mailcrawl/personal.db" python3 - <<'PY' || { log "default taxonomy: custom label did not map onto a Gmail category"; return 1; }
import os, sqlite3, sys
conn = sqlite3.connect(os.environ["MAP_DB"])
try:
    key = conn.execute("SELECT catalogue_key FROM labels WHERE gmail_label_id = 'Lshare'").fetchone()
finally:
    conn.close()
if key is None or key[0] != "CATEGORY_PROMOTIONS":
    sys.exit(key)
PY
  local map_dry example_dry
  map_dry="$(mailcrawl_in "$home" --json dry-run --account personal --rules "$REPO_ROOT/testdata/rules/rules-v0.json" --taxonomy "$map")"
  printf '%s' "$map_dry" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
ok = doc.get("inactive_reason") == "gmail_default" and doc.get("inactive_rules") == ["2", "2-read", "3", "4"]
sys.exit(0 if ok else 1)
' || { log "default taxonomy: gmail map activated content rules"; return 1; }
  example_dry="$(mailcrawl_in "$home" --json dry-run --account personal --rules "$REPO_ROOT/testdata/rules/rules-v0.json" --taxonomy "$REPO_ROOT/testdata/catalogue/taxonomy.synthetic.json")"
  printf '%s' "$example_dry" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
ok = doc.get("inactive_rules") == [] and doc.get("inactive_reason") is None
sys.exit(0 if ok else 1)
' || { log "default taxonomy: example schema left content rules inactive"; return 1; }
  rm -rf "$TAXONOMY_HOME"
  trap - EXIT
}

cmd_doctor() {
  mkdir -p "$EVIDENCE_DIR"
  {
    log "doctor run_id=$RUN_ID repo=$REPO_ROOT evidence=$EVIDENCE_DIR"
    if [[ "$(git -C "$REPO_ROOT" rev-parse --show-toplevel)" != "$REPO_ROOT" ]]; then
      log "REPO_ROOT is not git toplevel"
      exit 1
    fi
    record_spec_hash
    if scaffold_proof_runnable; then
      log "scaffold proof: runnable"
    else
      log "scaffold proof: not runnable (missing Makefile and/or scripts/proof.sh)"
    fi
    if native_fixture_runnable; then
      log "native gog import: runnable"
    else
      log "native gog import: not runnable (missing native fixture, missing taxonomy, or export.json is present)"
    fi
    if mbox_fixture_runnable; then
      log "mbox import: runnable"
    else
      log "mbox import: not runnable (missing testdata/fixtures/mbox/takeout.mbox or gog-after export)"
    fi
    if body_clean_runnable; then
      log "body clean: runnable"
    else
      log "body clean: not runnable (missing v0 export.json)"
    fi
    if attachment_parse_runnable; then
      log "attachment parse: runnable"
    else
      log "attachment parse: not runnable (missing v0 export or native fixture)"
    fi
    if rules_runnable; then
      log "rules v0: runnable"
    else
      log "rules v0: not runnable (missing testdata/rules/rules-v0.json)"
    fi
    if stats_runnable; then
      log "stats dry-run: runnable"
    else
      log "stats dry-run: not runnable (missing testdata/rules/rules-v0.json)"
    fi
    if taxonomy_runnable; then
      log "default taxonomy: runnable"
    else
      log "default taxonomy: not runnable (missing testdata/catalogue/taxonomy.synthetic.json)"
    fi
    if wheel_scenarios_runnable; then
      log "wheel scenarios: runnable (scratch venv installs setuptools>=77)"
    else
      log "wheel scenarios: not runnable (need pyproject.toml, bundled rules, pip, and venv)"
    fi
    log "doctor ok"
  } | tee "$EVIDENCE_DIR/doctor.log"
}

cmd_drive() {
  local feature="${1:-}"
  if [[ -z "$feature" ]]; then
    echo "usage: mailcrawl-verify drive --feature <id>" >&2
    exit 1
  fi
  mkdir -p "$EVIDENCE_DIR"
  local code=0
  {
    log "drive feature=$feature"
    local drive_code=0
    case "$feature" in
      required-docs-and-ci) drive_required_docs_and_ci || drive_code=$? ;;
      secrets-and-tracked-forbidden) drive_secrets_and_tracked_forbidden || drive_code=$? ;;
      spec-integrity) drive_spec_integrity || drive_code=$? ;;
      scaffold-headless-proof) drive_scaffold_headless_proof || drive_code=$? ;;
      native-gog-import) drive_native_gog_import || drive_code=$? ;;
      mbox-import) drive_mbox_import || drive_code=$? ;;
      body-clean) drive_body_clean || drive_code=$? ;;
      attachment-parse) drive_attachment_parse || drive_code=$? ;;
      rules-v0) drive_rules_v0 || drive_code=$? ;;
      stats-dry-run) drive_stats_dry_run || drive_code=$? ;;
      default-taxonomy) drive_default_taxonomy || drive_code=$? ;;
      time-closure-review) drive_wheel_scenario time-closure-review || drive_code=$? ;;
      owner-alias-from-me) drive_wheel_scenario owner-alias-from-me || drive_code=$? ;;
      wheel-rules-jev) drive_wheel_scenario wheel-rules-jev || drive_code=$? ;;
      revive-hold) drive_wheel_scenario revive-hold || drive_code=$? ;;
      closure-stays-queued) drive_wheel_scenario closure-stays-queued || drive_code=$? ;;
      *)
        log "unknown feature: $feature"
        drive_code=1
        ;;
    esac
    if [[ "$drive_code" -ne 0 ]]; then
      exit "$drive_code"
    fi
    verify_spec_unchanged || exit 1
    log "drive ok feature=$feature"
  } | tee "$EVIDENCE_DIR/drive.log" || code=$?
  append_summary "$feature" "$code"
  exit "$code"
}

cmd_cleanup() {
  rm -rf "$SCRATCH_DIR"
  shopt -s nullglob
  rm -rf /tmp/mailcrawl-wheel-*
  shopt -u nullglob
  log "cleanup done (evidence kept at $EVIDENCE_DIR)"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    doctor) cmd_doctor ;;
    drive)
      if [[ "${1:-}" == --feature ]]; then
        shift
        cmd_drive "${1:-}"
      else
        echo "usage: mailcrawl-verify drive --feature <id>" >&2
        exit 1
      fi
      ;;
    cleanup) cmd_cleanup ;;
    docs-secret-check) docs_secret_check ;;
    *)
      echo "usage: mailcrawl-verify {doctor|drive|cleanup|docs-secret-check}" >&2
      exit 1
      ;;
  esac
}

main "$@"
