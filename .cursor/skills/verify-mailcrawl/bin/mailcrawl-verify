#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="${REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
RUN_ID="${RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
EVIDENCE_DIR="${EVIDENCE_DIR:-/tmp/mailcrawl-verify-evidence/$RUN_ID}"
SCRATCH_DIR="/tmp/mailcrawl-verify-scratch/$RUN_ID"

log() {
  echo "[mailcrawl-verify] $*"
}

append_summary() {
  local feature="$1" code="$2"
  printf '%s feature=%s exit=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$feature" "$code" >>"$EVIDENCE_DIR/summary.txt"
}

scaffold_proof_runnable() {
  [[ -f "$REPO_ROOT/Makefile" && -f "$REPO_ROOT/scripts/proof.sh" ]]
}

body_clean_runnable() {
  [[ -f "$REPO_ROOT/testdata/fixtures/gog-export/v0/export.json" ]]
}

native_fixture_runnable() {
  local native="$REPO_ROOT/testdata/fixtures/gog-export/native"
  local taxonomy="$REPO_ROOT/testdata/catalogue/taxonomy.synthetic.json"
  [[ -f "$native/gmail/acct_synthetic/labels.json" \
    && -f "$native/gmail/acct_synthetic/messages/index.jsonl" \
    && -f "$taxonomy" \
    && ! -e "$native/export.json" ]]
}

mailcrawl_in() {
  local home="$1"
  shift
  (
    cd "$REPO_ROOT"
    env \
      -u GOG_KEY \
      -u OPENAI_API_KEY \
      -u ANTHROPIC_API_KEY \
      -u GH_TOKEN \
      -u GITHUB_TOKEN \
      -u GOOGLE_APPLICATION_CREDENTIALS \
      HOME="$home" \
      http_proxy=http://127.0.0.1:9 \
      https_proxy=http://127.0.0.1:9 \
      HTTP_PROXY=http://127.0.0.1:9 \
      HTTPS_PROXY=http://127.0.0.1:9 \
      ALL_PROXY=http://127.0.0.1:9 \
      python3 -m mailcrawl "$@"
  )
}

record_spec_hash() {
  mkdir -p "$EVIDENCE_DIR"
  sha256sum "$REPO_ROOT/docs/SPEC.md" | awk '{print $1}' >"$EVIDENCE_DIR/spec.sha256"
}

verify_spec_unchanged() {
  local before after
  before="$(cat "$EVIDENCE_DIR/spec.sha256")"
  after="$(sha256sum "$REPO_ROOT/docs/SPEC.md" | awk '{print $1}')"
  if [[ "$before" != "$after" ]]; then
    log "docs/SPEC.md changed during verification (hash mismatch)"
    return 1
  fi
  log "docs/SPEC.md unchanged"
  return 0
}

docs_secret_check() {
  "$REPO_ROOT/scripts/hygiene.sh"
}

drive_required_docs_and_ci() {
  local fail=0
  cd "$REPO_ROOT"
  for f in README.md docs/SPEC.md SECURITY.md CONTRIBUTING.md \
    .github/CODEOWNERS .github/dependabot.yml .github/workflows/check.yml; do
    if [[ ! -f "$f" ]]; then
      echo "missing $f"
      fail=1
    else
      echo "present $f"
    fi
  done
  [[ "$fail" -eq 0 ]]
}

drive_secrets_and_tracked_forbidden() {
  docs_secret_check
}

drive_spec_integrity() {
  verify_spec_unchanged
}

drive_scaffold_headless_proof() {
  if ! scaffold_proof_runnable; then
    log "scaffold-headless-proof: not runnable (need Makefile and scripts/proof.sh)"
    return 2
  fi
  cd "$REPO_ROOT"
  make check && scripts/proof.sh
}

drive_native_gog_import() {
  if ! native_fixture_runnable; then
    log "native gog import: not runnable"
    return 2
  fi
  mkdir -p "$SCRATCH_DIR"
  local home
  home="$(mktemp -d "$SCRATCH_DIR/native-home.XXXXXX")"
  NATIVE_HOME="$home"
  trap 'rm -rf "$NATIVE_HOME"' EXIT
  local native="$REPO_ROOT/testdata/fixtures/gog-export/native"
  local taxonomy="$REPO_ROOT/testdata/catalogue/taxonomy.synthetic.json"

  mailcrawl_in "$home" --json init --account thehive --email ada@example.com

  local import_out
  import_out="$(mailcrawl_in "$home" --json import gog-export \
    --account thehive \
    --dir "$native" \
    --taxonomy "$taxonomy")"
  printf '%s\n' "$import_out"
  printf '%s' "$import_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
ok = (
    doc.get("ok") is True
    and doc.get("n_seen") == 3
    and doc.get("n_new") == 3
    and doc.get("n_error") == 0
)
sys.exit(0 if ok else 1)
' || {
    log "native import count is not 3"
    return 1
  }

  local search_out
  search_out="$(mailcrawl_in "$home" --json search reuniao --account thehive)"
  printf '%s\n' "$search_out"
  printf '%s' "$search_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
hits = doc.get("hits") or []
ok = any(
    hit.get("gmail_message_id") == "msg-plain"
    and "reunião" in (hit.get("snippet") or "")
    for hit in hits
)
sys.exit(0 if ok else 1)
' || {
    log "native search reuniao missed reunião"
    return 1
  }

  local again_out
  again_out="$(mailcrawl_in "$home" --json import gog-export \
    --account thehive \
    --dir "$native")"
  printf '%s\n' "$again_out"
  printf '%s' "$again_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
ok = doc.get("n_dup") == 3 and doc.get("n_new") == 0
sys.exit(0 if ok else 1)
' || {
    log "native reimport was not a duplicate"
    return 1
  }

  local bad_out bad_err bad_code
  bad_err="$(mktemp "$SCRATCH_DIR/native-missing.XXXXXX")"
  bad_code=0
  bad_out="$(mailcrawl_in "$home" --json import gog-export \
    --account thehive \
    --dir "$home/missing-export" 2>"$bad_err")" || bad_code=$?
  printf '%s\n' "$bad_out"
  if [[ "$bad_code" -ne 3 ]]; then
    log "native-gog-import: missing directory exited $bad_code"
    return 1
  fi
  printf '%s' "$bad_out" | grep -q unsupported_schema || {
    log "native-gog-import: missing directory lacked unsupported_schema"
    return 1
  }
  if grep -q Traceback "$bad_err" || printf '%s' "$bad_out" | grep -q Traceback; then
    log "native-gog-import: missing directory printed a traceback"
    return 1
  fi
  rm -f "$bad_err"
  rm -rf "$NATIVE_HOME"
  trap - EXIT
}

drive_body_clean() {
  if ! body_clean_runnable; then
    log "body clean: not runnable"
    return 2
  fi
  mkdir -p "$SCRATCH_DIR"
  local home
  home="$(mktemp -d "$SCRATCH_DIR/body-home.XXXXXX")"
  BODY_HOME="$home"
  trap 'rm -rf "$BODY_HOME"' EXIT
  local export_dir="$REPO_ROOT/testdata/fixtures/gog-export/v0"
  local taxonomy="$REPO_ROOT/testdata/catalogue/taxonomy.synthetic.json"
  local db="$home/.local/share/mailcrawl/personal.db"

  mailcrawl_in "$home" --json init --account personal --email ada@example.com

  local import_out
  import_out="$(mailcrawl_in "$home" --json import gog-export \
    --account personal \
    --dir "$export_dir" \
    --taxonomy "$taxonomy")"
  printf '%s\n' "$import_out"
  printf '%s' "$import_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
ok = doc.get("ok") is True and doc.get("n_new") == 2 and doc.get("n_error") == 0
sys.exit(0 if ok else 1)
' || {
    log "body clean: v0 import failed"
    return 1
  }

  local quoted_out fake_out
  quoted_out="$(mailcrawl_in "$home" --json search quoted --account personal)"
  fake_out="$(mailcrawl_in "$home" --json search fake --account personal)"
  printf '%s\n' "$quoted_out"
  printf '%s\n' "$fake_out"
  DB_PATH="$db" QUOTED_JSON="$quoted_out" FAKE_JSON="$fake_out" python3 - <<'PY' || {
import json, os, sqlite3, sys
quoted = json.loads(os.environ["QUOTED_JSON"])
fake = json.loads(os.environ["FAKE_JSON"])
if quoted.get("hits"):
    sys.exit("quoted search returned hits")
ids = [hit.get("gmail_message_id") for hit in fake.get("hits") or []]
if "fixture-001" not in ids:
    sys.exit("fake search missed fixture-001")
conn = sqlite3.connect(os.environ["DB_PATH"])
try:
    raw, body = conn.execute(
        "SELECT body_text_raw, body_text FROM messages WHERE gmail_message_id = 'fixture-001'"
    ).fetchone()
    if "> quoted line stays" not in raw or "-- \nAda Fixture" not in raw:
        sys.exit("raw body dropped the quote or signature")
    if body != "This body is fake fixture text.":
        sys.exit("cleaned body is not the kept sentence")
    version = conn.execute("PRAGMA user_version").fetchone()[0]
    if version != 2:
        sys.exit(f"user_version {version}")
    names = {row[0] for row in conn.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    for table in ("decisions", "sender_decisions", "thread_mutes"):
        if table not in names:
            sys.exit(f"missing {table}")
    for banned in ("plans", "proposals", "embeddings", "clips"):
        if banned in names:
            sys.exit(f"unexpected {banned}")
finally:
    conn.close()
PY
    log "body clean: cleaned index check failed"
    return 1
  }

  local html_dir="$home/html-export"
  mkdir -p "$html_dir"
  cat >"$html_dir/export.json" <<'JSON'
{
  "schema": "mailcrawl.gog-export.v0",
  "example_manifest": {"messages": 1},
  "example_messages": [
    {
      "example_message_id": "html-clean-001",
      "example_thread_id": "thread-html-clean",
      "example_label_ids": ["INBOX"],
      "example_date": 1760054400,
      "example_from": "Ada Fixture <ada@example.com>",
      "example_html": "<p>Keep linhawordqx</p><blockquote>citacao quotewordqx</blockquote>"
    }
  ]
}
JSON
  mailcrawl_in "$home" --json import gog-export --account personal --dir "$html_dir" >/dev/null
  local html_out
  html_out="$(mailcrawl_in "$home" --json search quotewordqx --account personal)"
  printf '%s\n' "$html_out"
  printf '%s' "$html_out" | python3 -c '
import json, sys
doc = json.load(sys.stdin)
ids = [hit.get("gmail_message_id") for hit in doc.get("hits") or []]
sys.exit(0 if "html-clean-001" in ids else 1)
' || {
    log "body clean: html blockquote was cut"
    return 1
  }
  rm -rf "$BODY_HOME"
  trap - EXIT
}

cmd_doctor() {
  mkdir -p "$EVIDENCE_DIR"
  {
    log "doctor run_id=$RUN_ID repo=$REPO_ROOT evidence=$EVIDENCE_DIR"
    if [[ "$(git -C "$REPO_ROOT" rev-parse --show-toplevel)" != "$REPO_ROOT" ]]; then
      log "REPO_ROOT is not git toplevel"
      exit 1
    fi
    record_spec_hash
    if scaffold_proof_runnable; then
      log "scaffold proof: runnable"
    else
      log "scaffold proof: not runnable (missing Makefile and/or scripts/proof.sh)"
    fi
    if native_fixture_runnable; then
      log "native gog import: runnable"
    else
      log "native gog import: not runnable (missing native fixture, missing taxonomy, or export.json is present)"
    fi
    if body_clean_runnable; then
      log "body clean: runnable"
    else
      log "body clean: not runnable (missing v0 export.json)"
    fi
    log "doctor ok"
  } | tee "$EVIDENCE_DIR/doctor.log"
}

cmd_drive() {
  local feature="${1:-}"
  if [[ -z "$feature" ]]; then
    echo "usage: mailcrawl-verify drive --feature <id>" >&2
    exit 1
  fi
  mkdir -p "$EVIDENCE_DIR"
  local code=0
  {
    log "drive feature=$feature"
    local drive_code=0
    case "$feature" in
      required-docs-and-ci) drive_required_docs_and_ci || drive_code=$? ;;
      secrets-and-tracked-forbidden) drive_secrets_and_tracked_forbidden || drive_code=$? ;;
      spec-integrity) drive_spec_integrity || drive_code=$? ;;
      scaffold-headless-proof) drive_scaffold_headless_proof || drive_code=$? ;;
      native-gog-import) drive_native_gog_import || drive_code=$? ;;
      body-clean) drive_body_clean || drive_code=$? ;;
      *)
        log "unknown feature: $feature"
        drive_code=1
        ;;
    esac
    if [[ "$drive_code" -ne 0 ]]; then
      exit "$drive_code"
    fi
    verify_spec_unchanged || exit 1
    log "drive ok feature=$feature"
  } | tee "$EVIDENCE_DIR/drive.log" || code=$?
  append_summary "$feature" "$code"
  exit "$code"
}

cmd_cleanup() {
  rm -rf "$SCRATCH_DIR"
  log "cleanup done (evidence kept at $EVIDENCE_DIR)"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    doctor) cmd_doctor ;;
    drive)
      if [[ "${1:-}" == --feature ]]; then
        shift
        cmd_drive "${1:-}"
      else
        echo "usage: mailcrawl-verify drive --feature <id>" >&2
        exit 1
      fi
      ;;
    cleanup) cmd_cleanup ;;
    docs-secret-check) docs_secret_check ;;
    *)
      echo "usage: mailcrawl-verify {doctor|drive|cleanup|docs-secret-check}" >&2
      exit 1
      ;;
  esac
}

main "$@"
